# Токен сообщества VK с доступом к сообщениям
VK_GROUP_TOKEN=
# VK API (основной домен api.vk.ru; при сетевой ошибке есть совместимый fallback)
VK_API_VERSION=5.199
VK_API_BASE_URL=https://api.vk.ru/method

# Относительный путь считается относительно папки проекта; для абсолютного укажите полный путь
DB_PATH=bot.db
